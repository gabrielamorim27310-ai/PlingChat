# Porta HTTP do servidor (padrao 3000)
PORT=3000

# Segredo dos tokens JWT. Se ausente, e gerado e salvo em data/.secret
NEXUS_SECRET=

# Dominios que podem chamar esta API, separados por virgula.
# Vazio libera qualquer origem (adequado para uso local).
ALLOWED_ORIGINS=

# Client ID do OAuth do Google. E um valor publico: vai para o navegador.
# O client secret NAO e usado neste fluxo — nao coloque ele aqui.
GOOGLE_CLIENT_ID=
