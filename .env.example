# Porta HTTP do servidor (padrao 3000)
PORT=3000

# String de conexao do Postgres (Supabase). Use o "Transaction Pooler"
# (porta 6543) — a conexao direta e IPv6-only e nao resolve em varios hosts.
# Formato: postgresql://postgres.[ref]:[senha]@aws-0-[regiao].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Segredo dos tokens JWT. Se ausente, e gerado e salvo em data/.secret
NEXUS_SECRET=

# Dominios que podem chamar esta API, separados por virgula.
# Vazio libera qualquer origem (adequado para uso local).
ALLOWED_ORIGINS=

# Client ID do OAuth do Google. E um valor publico: vai para o navegador.
# O client secret NAO e usado neste fluxo — nao coloque ele aqui.
GOOGLE_CLIENT_ID=

# Cadastro: "invite" (padrao, exige codigo) ou "open"
SIGNUP_MODE=invite
MAX_INVITES_PER_USER=5

# ID do usuario dono do app: sem limite de convites ativos (os outros
# ficam presos ao MAX_INVITES_PER_USER acima). Convites de qualquer
# pessoa ja nao tem limite de usos por codigo, so de quantos ficam ativos.
OWNER_USER_ID=

# Envio de e-mail (verificacao e recuperacao de senha) via Resend
RESEND_API_KEY=
MAIL_FROM=PlingChat <nao-responda@plingchat.com>
APP_URL=http://localhost:3000

# Cloudflare Turnstile (CAPTCHA). Sem as duas chaves o desafio fica desligado.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Notificacoes push (Web Push). Gere uma vez com:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Nao depende de nenhuma conta externa. Sem as duas chaves, fica desligado.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com
